<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AvaloniaApp.MainWindow"
        Title="Вычисление приближенного значения определенного интеграла"
        Width="700" Height="500">

    <StackPanel Margin="10">
        <TextBlock Text="Вычисление приближенного значения определенного интеграла" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0 0 0 10"/>
        
        <Button x:Name="ClearButton" Content="Очистить" HorizontalAlignment="Left" Click="ClearButton_Click" Margin="0 0 0 10"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Функция:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0 0 5 5"/>
            <TextBox x:Name="FunctionTextBox" Grid.Row="0" Grid.Column="1" Margin="0 0 0 5"/>
            
            <TextBlock Text="Нижний предел&#10;интегрирования(a):" Grid.Row="1" Grid.Column="0" Margin="0 0 5 5"/>
            <TextBox x:Name="LowerLimitTextBox" Grid.Row="1" Grid.Column="1" Margin="0 0 0 5"/>
            
            <TextBlock Text="Верхний предел&#10;интегрирования(b):" Grid.Row="2" Grid.Column="0" Margin="0 0 5 5"/>
            <TextBox x:Name="UpperLimitTextBox" Grid.Row="2" Grid.Column="1" Margin="0 0 0 5"/>

            <TextBlock Text="Точность(eps):" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0 0 5 5"/>
            <TextBox x:Name="EpsTextBox" Grid.Row="3" Grid.Column="1" Margin="0 0 0 5"/>
        </Grid>

        <Button x:Name="CalculateButton" Content="Вычислить" HorizontalAlignment="Center" Click="CalculateButton_Click" Margin="0 10 0 10"/>
        
        <TextBlock Text="Результаты" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" Margin="0 10 0 5"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Метод" Grid.Row="0" Grid.Column="0" Margin="0 5 5 5"/>
            <TextBlock Text="Значение интеграла" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" Margin="0 5 5 5"/>
            <TextBlock Text="Время" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" Margin="0 5 5 5"/>
            <TextBlock Text="Погрешность" Grid.Row="0" Grid.Column="3" HorizontalAlignment="Center" Margin="0 5 5 5"/>
            <TextBlock Text="Трапеций" Grid.Row="1" Grid.Column="0" Margin="0 5 5 5"/>
            <TextBlock Text="Симпсона" Grid.Row="2" Grid.Column="0" Margin="0 5 5 5"/>
            <TextBlock Text="Ньютона" Grid.Row="3" Grid.Column="0" Margin="0 5 5 5"/>

            <TextBox x:Name="TrapezoidMethodValue" Grid.Row="1" Grid.Column="1" Margin="0 5 0 5"/>
            <TextBox x:Name="SimpsonMethodValue" Grid.Row="2" Grid.Column="1" Margin="0 5 0 5"/>
            <TextBox x:Name="NewtonMethodValue" Grid.Row="3" Grid.Column="1" Margin="0 5 0 5"/>
            <TextBox x:Name="TrapezoidMethodTime" Grid.Row="1" Grid.Column="2" Margin="0 5 0 5"/>
            <TextBox x:Name="SimpsonMethodTime" Grid.Row="2" Grid.Column="2" Margin="0 5 0 5"/>
            <TextBox x:Name="NewtonMethodTime" Grid.Row="3" Grid.Column="2" Margin="0 5 0 5"/>
            <TextBox x:Name="TrapezoidMethodError" Grid.Row="1" Grid.Column="3" Margin="0 5 0 5"/>
            <TextBox x:Name="SimpsonMethodError" Grid.Row="2" Grid.Column="3" Margin="0 5 0 5"/>
            <TextBox x:Name="NewtonMethodError" Grid.Row="3" Grid.Column="3" Margin="0 5 0 5"/>          
        </Grid>
    </StackPanel>
</Window>
